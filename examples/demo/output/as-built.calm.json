          "source": {
            "node": "api.payments"
          },
          "destination": {
            "node": "stripe"
          }
        }
      }
    },
    {
      "unique-id": "web-connects-api",
      "description": "depends_on, imports",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web"
          },
          "destination": {
            "node": "api"
          }
        }
      }
    },
    {
      "unique-id": "web.cart-connects-shop_shared",
