          "container": "web",
          "nodes": [
            "web.cart"
          ]
        }
      }
    },
    {
      "unique-id": "api-connects-db",
      "description": "depends_on, env DATABASE_URL",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "api"
          },
          "destination": {
            "node": "db"
          }
        }
      }
    },
    {
