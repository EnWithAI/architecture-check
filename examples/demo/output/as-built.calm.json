  "relationships": [
    {
      "unique-id": "api-composed-of",
      "relationship-type": {
        "composed-of": {
          "container": "api",
          "nodes": [
            "api.orders",
            "api.payments"
          ]
        }
      }
    },
    {
      "unique-id": "system-composed-of",
      "relationship-type": {
